{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["src/**", "package.json", "tsconfig*.json", "tsup.config.*"],
      "outputs": ["dist/**"]
    },
    "lint": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "test:int": {
      "dependsOn": ["^build"],
      "outputs": [],
      "cache": false,
      "passThroughEnv": [
        "DATABASE_URL",
        "REDIS_URL",
        "NODE_ENV",
        "JWT_ACCESS_PRIVATE_KEY",
        "JWT_ACCESS_PUBLIC_KEY",
        "JWT_ACCESS_TTL",
        "JWT_REFRESH_TTL_DAYS",
        "PASSWORD_PEPPER"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}

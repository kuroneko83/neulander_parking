# Esqueleto de variáveis de ambiente — Neulander Parking
#
# Copie para `.env` (nunca commite `.env`; ver .gitignore) e preencha com valores
# reais/sandbox. Todos os valores abaixo são placeholders/dummy — nenhum segredo real.
# Em produção, estas chaves vivem no Secrets Manager (AWS), não em arquivo (ADR-0004, ADR-0009).
#
# Os módulos concretos (apps/api etc.) ainda não existem (Fase 0, tarefa 0.1) — este
# arquivo antecipa as variáveis já previsíveis pela stack descrita em CLAUDE.md/ADRs.

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
NODE_ENV=development
# Fuso padrão de apresentação; cada parking_lot também tem seu próprio timezone (banco em UTC).
TZ=America/Sao_Paulo
# Porta 3333 (não a 3000 padrão): nesta máquina de dev a 3000 e a 3001 já estão
# ocupadas por outros projetos — ajuste se não for o seu caso.
API_PORT=3333
API_HOST=0.0.0.0
# Origem(s) permitidas para CORS do painel web, separadas por vírgula.
CORS_ORIGIN=http://localhost:5173
LOG_LEVEL=info

# ---------------------------------------------------------------------------
# Web (apps/web — ULTRAPLAN 0.7)
# ---------------------------------------------------------------------------
# Lido só pelo Vite (client-side, prefixo VITE_ obrigatório) — vite.config.ts
# aponta `envDir` pra raiz do monorepo, então este arquivo cobre o web também.
VITE_API_URL=http://localhost:3333

# ---------------------------------------------------------------------------
# Postgres + PostGIS (ADR-0003)
# ---------------------------------------------------------------------------
# POSTGRES_USER/PASSWORD/DB são lidos diretamente pelo infra/docker/compose.yml
# (imagem postgis/postgis) — precisam bater com as credenciais/host/porta/db
# embutidos em DATABASE_URL abaixo, para não ter duas fontes de verdade divergentes.
# Porta 5433 (não a 5432 padrão): nesta máquina de dev já existe outro Postgres
# ocupando a 5432 (container de outro projeto) — ajuste se não for o seu caso.
POSTGRES_USER=neulander
POSTGRES_PASSWORD=neulander
POSTGRES_DB=neulander_parking
DATABASE_URL=postgresql://neulander:neulander@localhost:5433/neulander_parking
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10

# ---------------------------------------------------------------------------
# Redis (BullMQ, Socket.IO adapter — ADR-0006, ADR-0007)
# ---------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379

# ---------------------------------------------------------------------------
# Auth — JWT RS256 + refresh rotativo (ADR-0004)
# ---------------------------------------------------------------------------
# Par de chaves RSA em PEM (dev: gere um par local; produção: Secrets Manager).
# Use \n para quebras de linha se mantiver a chave em uma única linha de .env.
# Substitua o bloco inteiro (não só "CHANGE_ME") por uma chave PEM real gerada localmente.
JWT_ACCESS_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nCHANGE_ME\n-----END PRIVATE KEY-----"
JWT_ACCESS_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\nCHANGE_ME\n-----END PUBLIC KEY-----"
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30
# Pepper adicional ao hash argon2id das senhas (mínimo 32 caracteres — ver env.schema.ts).
PASSWORD_PEPPER=dev-pepper-change-me-please-32-chars-min

# ---------------------------------------------------------------------------
# Convite de membros / e-mail (ADR-0013, ULTRAPLAN 1.5)
# ---------------------------------------------------------------------------
# Base do painel web — usada para montar o link de aceite de convite.
WEB_APP_URL=http://localhost:5173
# SmtpEmailChannel (nodemailer) usa SMTP_URL; se ausente, cai para SMTP_DEV_URL (Mailpit
# local, seção abaixo) — deixe comentado em dev, o default de SMTP_DEV_URL já basta.
#SMTP_URL=smtps://usuario:senha@smtp.exemplo.com:587
EMAIL_FROM=relatorios@neulander-parking.example.com

# ---------------------------------------------------------------------------
# S3 — imagens de placa (recortes), relatórios PDF (CLAUDE.md regra 10)
# Em dev/CI: LocalStack (substitui MinIO, descontinuado — ADR-0015). Em
# produção: S3 real da AWS (Fase 11, ADR-0009) — só o endpoint/credenciais mudam.
# ---------------------------------------------------------------------------
S3_ENDPOINT=http://localhost:4566
S3_REGION=us-east-1
S3_BUCKET_PLATE_IMAGES=neulander-plate-images-dev
S3_BUCKET_REPORTS=neulander-reports-dev
# Credenciais dummy (convenção do LocalStack) — qualquer valor funciona em dev.
S3_ACCESS_KEY_ID=test
S3_SECRET_ACCESS_KEY=test
# true no LocalStack local; false na AWS (S3 real).
S3_FORCE_PATH_STYLE=true
# Desde 23/03/2026 a LocalStack exige conta + token mesmo para o uso "community"
# (ADR-0015). Crie uma conta gratuita (plano Hobby, uso não comercial) em
# https://app.localstack.cloud, gere um token e cole aqui — só no seu `.env`
# local, nunca commitado (ver .gitignore). Sem isso o container `localstack`
# não inicia (erro "License activation failed").
LOCALSTACK_AUTH_TOKEN=CHANGE_ME

# ---------------------------------------------------------------------------
# E-mail — Amazon SES (relatório diário, adapter SesEmailChannel — ADR-0013)
# ---------------------------------------------------------------------------
SES_REGION=us-east-1
SES_ACCESS_KEY_ID=CHANGE_ME
SES_SECRET_ACCESS_KEY=CHANGE_ME
SES_FROM_EMAIL=relatorios@neulander-parking.example.com
# Em dev, usar Mailpit local (docker compose) em vez de SES real.
SMTP_DEV_URL=smtp://localhost:1025

# ---------------------------------------------------------------------------
# WhatsApp Business Cloud API — Meta (adapter WhatsAppCloudChannel — ADR-0013)
# ---------------------------------------------------------------------------
WHATSAPP_CLOUD_API_BASE_URL=https://graph.facebook.com/v21.0
WHATSAPP_PHONE_NUMBER_ID=CHANGE_ME
WHATSAPP_BUSINESS_ACCOUNT_ID=CHANGE_ME
WHATSAPP_ACCESS_TOKEN=CHANGE_ME
# Segredo do app Meta, usado para validar X-Hub-Signature-256 no webhook.
WHATSAPP_APP_SECRET=CHANGE_ME
# Token arbitrário definido por nós para o handshake de verificação do webhook (GET).
WHATSAPP_WEBHOOK_VERIFY_TOKEN=dev-verify-token-change-me

# ---------------------------------------------------------------------------
# Mercado Pago — Pix (adapter PaymentProvider — ADR-0005)
# ---------------------------------------------------------------------------
MERCADO_PAGO_ACCESS_TOKEN=TEST-CHANGE_ME
MERCADO_PAGO_PUBLIC_KEY=TEST-CHANGE_ME
MERCADO_PAGO_WEBHOOK_SECRET=CHANGE_ME

# ---------------------------------------------------------------------------
# Stripe — cartão (adapter PaymentProvider — ADR-0005)
# ---------------------------------------------------------------------------
STRIPE_SECRET_KEY=sk_test_CHANGE_ME
STRIPE_PUBLISHABLE_KEY=pk_test_CHANGE_ME
STRIPE_WEBHOOK_SECRET=whsec_CHANGE_ME

{
  "name": "api",
  "version": "0.0.0",
  "private": true,
  "description": "Neulander Parking — API NestJS (monólito modular) e worker (mesmo código, entrypoint diferente). ULTRAPLAN 0.3.",
  "engines": {
    "node": "^22.12.0"
  },
  "scripts": {
    "dev": "nest start --watch",
    "dev:worker": "nest start --watch --entryFile main.worker",
    "build": "nest build",
    "start": "node dist/main.js",
    "start:worker": "node dist/main.worker.js",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run -c vitest.config.mts",
    "test:int": "vitest run -c vitest.config.int.mts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/database/migrate.ts",
    "db:seed": "tsx src/database/seed.ts"
  },
  "dependencies": {
    "@neulander/contracts": "workspace:*",
    "@nestjs/bullmq": "^12.0.0",
    "@nestjs/common": "^10",
    "@nestjs/config": "^3",
    "@nestjs/core": "^10",
    "@nestjs/platform-express": "^10",
    "@nestjs/swagger": "^8",
    "@nestjs/terminus": "^10",
    "bullmq": "^6.3.8",
    "dotenv": "^18.0.3",
    "drizzle-orm": "^0.45.3",
    "ioredis": "^6.0.0",
    "nestjs-pino": "^4.6.1",
    "nestjs-zod": "^5.5.0",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "uuid": "^14.0.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@nestjs/cli": "^10",
    "@nestjs/testing": "^10",
    "@neulander/config": "workspace:*",
    "@types/express": "^4.17.25",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "drizzle-kit": "^0.31.11",
    "pino-pretty": "^13.1.3",
    "supertest": "^7.3.0",
    "tsx": "^4.23.15"
  }
}

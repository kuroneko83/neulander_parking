# pnpm workspace settings — see docs/adr/0002-monorepo-pnpm-turborepo.md

# Fail fast if the active Node/pnpm don't satisfy "engines" instead of silently continuing.
engine-strict=true

# Some tooling (e.g. eslint, vitest) declares optional peers we don't always use;
# auto-installing them keeps `pnpm install` from erroring on every optional peer.
auto-install-peers=true

# Keep lockfile resolution strict and reproducible across machines/CI.
strict-peer-dependencies=false
save-exact=false

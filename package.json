{
  "name": "neulander-parking",
  "version": "0.0.0",
  "private": true,
  "description": "Plataforma de estacionamentos com LPR, painel web e app mobile — monorepo pnpm + Turborepo.",
  "engines": {
    "node": "^22.12.0",
    "pnpm": ">=9.15.0"
  },
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:int": "turbo run test:int",
    "build": "turbo run build",
    "format": "prettier --check .",
    "format:write": "prettier --write ."
  },
  "devDependencies": {
    "@neulander/config": "workspace:*",
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.4",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "prettier": "^3.9.9",
    "tsup": "^8.5.1",
    "turbo": "^2.11.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.1"
  }
}
